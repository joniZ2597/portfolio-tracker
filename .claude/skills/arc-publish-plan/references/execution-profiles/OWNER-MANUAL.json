    ],
    "forbidden": [
      ".git/arc-runtime/**",
      "pt_*"
    ]
  },
  "capabilities": {
    "network": "none",
    "browser": "owner-profile",
    "git": "read-only",
    "deploy": "none",
    "gates": "none",
