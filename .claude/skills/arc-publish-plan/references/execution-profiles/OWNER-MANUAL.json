  },
  "tools": {
    "allowed": [],
    "forbidden": [
      "mcp__claude_ai_Netlify__*",
      "WebFetch",
      "WebSearch",
      "Bash(netlify *)",
      "Bash(git push*)",
      "Bash(git commit*)"
    ]
  },
  "skills": {
    "required": [],
    "demandOnly": [],
    "ownerInvokedOnly": []
  },
  "phases": [
    {
      "id": "OWNER",
      "kind": "VERIFY",
      "recommendedMode": "MANUAL",
      "modeCeiling": "MANUAL",
      "entryGate": "NONE",
      "writes": [],
      "exit": "owner performs the task by hand; not workable by /arc-worker"
    }
  ],
  "approvalBoundaries": {
    "inside": [],
    "outside": [
      "git-stage",
      "git-commit",
      "git-push",
      "deploy",
      "env-change",
      "gate-toggle",
      "live-external-call",
      "pt-write",
      "runtime-mutation-other-claim",
      "scope-expansion",
      "production"
    ]
  },
  "verification": {
    "suites": [],
    "selfTest": "n/a (owner act)",
    "evidence": "CHECKPOINT note",
    "proofStyle": "owner-attested"
  },
  "triggers": [
    {
      "on": "containment-breach",
      "action": "STOP"
    },
    {
      "on": "target-surface-changed",
      "action": "BLOCKED"
    },
    {
      "on": "two-failed-attempts",
      "action": "BLOCKED",
