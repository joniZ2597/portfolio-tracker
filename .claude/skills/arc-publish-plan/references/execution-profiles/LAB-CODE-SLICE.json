{
  "profileId": "LAB-CODE-SLICE",
  "version": 1,
  "appliesToLane": "LAB",
  "scope": {
    "worktree": "portfolio-tracker-test-lab",
    "pinnedRef": "PLAN_REPO_REF",
    "writes": [
      "<worktree>/index.html",
      "<worktree>/qa/**",
      ".ai-reports/handoffs/*.LAB.md"
    ],
    "readOnly": [
      "<worktree>/**",
      "git show <pinnedRef>:**"
    ],
    "forbidden": [
      "branch-dev:index.html",
      "branch-dev:netlify/**",
      "<worktree>/netlify/**",
      "<worktree>/.netlify/**",
      ".netlify/**",
      ".git/arc-runtime/** (except own claim + own mutex holders)",
      "pt_*"
    ]
  },
  "capabilities": {
    "network": "none",
    "browser": "isolated-profile",
    "git": "read-only",
    "deploy": "none",
    "gates": "none",
    "ownerProfile": "none"
  },
  "tools": {
    "allowed": [
      "Read",
      "Grep",
      "Glob",
      "Bash",
      "Write",
      "Edit"
    ],
    "forbidden": [
      "mcp__claude_ai_Netlify__*",
      "WebFetch",
      "WebSearch",
      "Bash(netlify *)",
      "Bash(git push*)",
      "Bash(git commit*)"
    ]
  },
  "skills": {
    "required": [],
    "demandOnly": [
      "lab-planner",
      "browser-integrity-qa"
    ],
    "ownerInvokedOnly": [
      "lab-planner",
      "browser-integrity-qa"
    ]
  },
  "phases": [
    {
      "id": "PLAN",
      "kind": "IMPLEMENT",
      "recommendedMode": "MANUAL",
      "modeCeiling": "MANUAL",
      "entryGate": "AUTHORIZED_JSON",
      "writes": [],
      "exit": "worktree verified at pinnedRef; entry-point facts re-verified; design recorded in scratch"
    },
    {
      "id": "IMPLEMENT",
      "kind": "IMPLEMENT",
      "recommendedMode": "ACCEPT_EDITS",
      "modeCeiling": "ACCEPT_EDITS",
      "entryGate": "NONE",
      "writes": [
        "<worktree>/index.html",
        "<worktree>/qa/**"
      ],
      "exit": "declared surface implemented; new suite(s) authored; no path outside the declared surface touched"
    },
    {
      "id": "VERIFY",
      "kind": "VERIFY",
      "recommendedMode": "AUTO",
      "modeCeiling": "AUTO",
      "entryGate": "NONE",
      "writes": [],
      "exit": "npm run qa:offline exit 0 in the worktree; effective set equals pinnedRef set plus exactly the declared new suites"
    },
    {
      "id": "BROWSER",
      "kind": "VERIFY",
      "recommendedMode": "MANUAL",
      "modeCeiling": "MANUAL",
      "entryGate": "NONE",
      "writes": [],
      "exit": "isolated browser origin against the worktree build; every acceptance state exercised; pt_* byte-identical before/after; no live provider call"
    },
    {
      "id": "HANDOFF",
      "kind": "REPORT",
      "recommendedMode": "ACCEPT_EDITS",
      "modeCeiling": "ACCEPT_EDITS",
      "entryGate": "NONE",
      "writes": [
        ".ai-reports/handoffs/*.LAB.md"
      ],
      "exit": "handoff registered with delta stat, delta sha256 vs pinnedRef, suite counts, browser evidence"
    },
    {
      "id": "CLOSE",
      "kind": "TERMINAL",
      "recommendedMode": "MANUAL",
      "modeCeiling": "MANUAL",
      "entryGate": "NONE",
      "writes": [
        "claims/{TASK_ID}/claim.json"
      ],
      "exit": "COMPLETE written; own mutexes released (claim-protocol section 7)"
    }
  ],
  "approvalBoundaries": {
    "inside": [],
    "outside": [
      "git-stage",
      "git-commit",
      "git-push",
      "deploy",
      "env-change",
      "gate-toggle",
      "live-external-call",
      "pt-write",
      "runtime-mutation-other-claim",
      "scope-expansion",
      "production"
    ]
  },
  "verification": {
    "suites": [],
    "selfTest": "qa:offline in the worktree plus the task's own new suite(s); counts printed",
    "evidence": "LAB handoff + worktree delta (never committed by LAB)",
    "proofStyle": "counts-not-claims"
  },
  "triggers": [
    {
      "on": "containment-breach",
      "action": "STOP",
      "reason": "any write outside <worktree>/index.html, <worktree>/qa/**, own handoff, own claim - and any Netlify CLI or .netlify path (main worktree state is linked to production)"
    },
    {
      "on": "target-surface-changed",
      "action": "BLOCKED"
    },
    {
      "on": "two-failed-attempts",
      "action": "BLOCKED",
      "reason": "entry-mode-insufficient"
    },
    {
      "on": "mode-exceeds-ceiling",
      "action": "STOP-before-write"
    },
    {
      "on": "automation-increase-needed",
      "action": "STOP-request-MODE-literal"
    },
    {
      "on": "newer-artifact-observed",
      "action": "REPORT-stay-on-snapshot"
    },
    {
      "on": "live-call-needed",
      "action": "BLOCKED",
      "reason": "needs EXTERNAL:live-provider - live canaries are MAIN release verification (MAIN-GATED-LIVE-QA), never a LAB phase"
    }
  ],
  "cleanup": {
    "scratch": "scratchpad only, deleted",
    "sandbox": "worktree delta retained uncommitted until MAIN applies or discards it; never committed by LAB",
    "gates": "n/a",
    "mutexes": "release own classes at COMPLETE (claim-protocol section 7)",
    "handoff": "required",
    "checkpoint": "owner note",
    "conversation": "retire after report (Policy v3 section D)"
  }
}
